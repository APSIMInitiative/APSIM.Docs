@using APSIM.Docs.Components.Layout
@using APSIM.Docs.Components.Custom
@using APSIM.Docs.Services
@inject IHtmlDocsService HtmlDocsService
@inject IDocsService DocsService

@rendermode InteractiveServer
@page "/"

<PageTitle>APSIM Docs</PageTitle>

<h1 class="page-heading">Documentation Sections</h1>

<h2 class="page-heading">HTML Docs</h2>
<div class="container">
	<div class="row">
		@foreach (var htmlSection in HtmlDocsService.GetSections())
		{
			<DocLink
			DocDisplayName="@htmlSection.Name"
			DocModelName="@htmlSection.Name"
				DocDescript="Browse HTML documentation section."
			DocLinkHref="@GetHtmlSectionHref(htmlSection.Slug)" />
		}
	</div>
</div>

<h2 class="page-heading mt-4">Markdown Docs</h2>
<div class="container">
	<div class="row">
		@foreach (var markdownSection in DocsService.GetTopLevelSections())
		{
			<DocLink
			DocDisplayName="@markdownSection.Name"
			DocModelName="@markdownSection.Name"
				DocDescript="Browse markdown documentation section."
			DocLinkHref="@($"/docs/{markdownSection.SlugPath}")" />
		}
	</div>
</div>

@code {
	private static string GetHtmlSectionHref(string sectionSlug)
	{
		return sectionSlug switch
		{
			"models" => "/models",
			"tutorials" => "/tutorials",
			"validation" => "/validation",
			_ => $"/html/{sectionSlug}"
		};
	}
}
