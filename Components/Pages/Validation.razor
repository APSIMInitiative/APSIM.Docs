@using APSIM.Docs.Components.Layout
@using APSIM.Docs.Services
@inject IHtmlDocsService HtmlDocsService
@inject NavigationManager NavigationManager

@rendermode InteractiveServer
@page "/validation"
@page "/validation/{filename}"

<PageTitle>@pageTitle</PageTitle>

<HeadContent>
    <style id="style">
        @cssString
    </style>
</HeadContent>

<h1 class="page-heading">@heading</h1>

@if (IsNotFound)
{
    <div class="container">
        <div class="row"><span class="col">The document you selected is currently unavailable. Please submit an issue.</span></div>
        <div class="row"><span class="col"><a target="_blank" href="https://github.com/APSIMInitiative/APSIM.Docs/issues">APSIM.Docs issues</a></span></div>
    </div>
}
else if (ShowIndex)
{
    <HtmlSectionLinks SectionSlug="validation" LinkBaseHref="/validation" />
}
else
{
    <div>@docString</div>
}

@code {
    private string pageTitle = "APSIM Docs - Validation";
    private string heading = "Validation";
    private MarkupString docString;
    private MarkupString cssString;

    [Parameter]
    public string? Filename { get; set; }

    private bool IsNotFound { get; set; }

    private bool ShowIndex => string.IsNullOrWhiteSpace(Filename) && !IsNotFound;

    protected override void OnInitialized()
    {
        cssString = new MarkupString(File.ReadAllText($"wwwroot{Path.DirectorySeparatorChar}docs.css"));
    }

    protected override void OnParametersSet()
    {
        IsNotFound = false;
        docString = default;
        heading = "Validation";
        pageTitle = "APSIM Docs - Validation";

        if (string.IsNullOrWhiteSpace(Filename))
        {
            if (HtmlDocsService.TryGetSection("validation") is null)
            {
                IsNotFound = true;
                pageTitle = "APSIM Docs - Not Found";
            }

            return;
        }

        var page = HtmlDocsService.TryGetPage("validation", Filename);
        if (page is null)
        {
            IsNotFound = true;
            pageTitle = "APSIM Docs - Not Found";
            return;
        }

        heading = page.DisplayName;
        pageTitle = $"APSIM Docs - {page.DisplayName}";
        docString = new MarkupString(HtmlDocsService.RenderPageHtml(page, NavigationManager.Uri));
    }
}